# Copy to .env and adjust. .env is gitignored; this file is committed.
#
# Every key the code reads is listed here. Keys written out are ones to set;
# keys commented out show their default, which is what an installation that
# leaves them out gets -- uncomment one only to change it. A key not listed
# here stops the API at start-up, so a misspelling cannot pass unnoticed.
# A relative folder is taken from the repository root.

# --- database ----------------------------------------------------------------

# SQLAlchemy connection URL. The local dev cluster is created by initdb into
# .pgdata -- see the environment setup document for your OS for creating it
# and the runtime operations document for starting and stopping it. The
# scripts start that cluster on this URL's port, whatever its own
# postgresql.conf says.
DATABASE_URL=postgresql+psycopg://ccwebdb:devpassword@localhost:5432/ccwebdb

# The cluster folder this machine's scripts start and stop.
# CCWEB_DB_CLUSTER_DIR=.pgdata

# A cluster of this machine's own for the tests, which build and drop their
# databases there and never in the collection's cluster. Its port must not
# be DATABASE_URL's.
# CCWEB_TEST_DB_CLUSTER_DIR=.pgdata.test
# CCWEB_TEST_DB_PORT=5433
# Unset: the test cluster above. A database named ..._test elsewhere, if set.
# TEST_DATABASE_URL=

# --- sign-in -----------------------------------------------------------------

# Generate a fresh value per environment:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The API refuses to start without one, or with one under 32 characters.
JWT_SECRET=
# JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# The administrator `python -m app.seed` creates on a trial installation.
# `python -m app.create_admin` takes FIRST_ADMIN_PASSWORD, when set, in
# place of asking for one. Both refuse a password under 12 characters or
# one published in this repository.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=

# --- the shop ------------------------------------------------------------------

# Whether the public shop is open. false shows visitors who are not signed in
# a coming-soon page, and the API refuses them the catalog and registration.
# Set it to true, and restart the API, on opening day.
SHOP_OPEN=true

# Sales tax on acquisitions. Read when the API starts, and copied onto each
# item when it is created -- so a change governs purchases recorded after it
# and rewrites none recorded before it. A fraction, not a percentage: 0.0635
# is 6.35%. Unset: 0, no tax -- set your own rate. Restart the API after
# changing either.
# SALES_TAX_RATE=0
# Whether shipping is part of the taxed amount.
SALES_TAX_INCLUDES_SHIPPING=true

# The IANA time zone "today" and every local date is in, for example
# America/New_York. Empty: the computer's own zone. Set it on a server whose
# clock runs on UTC, or its evenings fall on the next day in every report.
# TIME_ZONE=

# DigiCert's site seal for the certificate the shop is served under: the
# eight characters after DigiCertClickID_ in DigiCert's seal code. Read when
# the frontend is built. Empty: the shop shows no seal.
# VITE_DIGICERT_SEAL_ID=

# The shop's name, shown in its header, page titles and coming-soon page,
# and the legal name the footer's copyright line names. Read when the
# frontend is built. Empty: "Coin Shop", and no copyright holder named.
# VITE_SHOP_NAME=
# VITE_SHOP_OWNER=

# --- the API -------------------------------------------------------------------

# API_PREFIX=/api
# Addresses allowed to call the API from a browser, as a JSON list. Unset:
# the development server's two, http://localhost and http://127.0.0.1 at
# CCWEB_FRONTEND_PORT.
# CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# --- photographs ---------------------------------------------------------------

# Where stored photographs live, and where `python -m app.photo_import`
# looks for files to import. Unset: the media and photos folders in the
# repository. A relative MEDIA_ROOT is taken from the repository folder;
# give PHOTO_LIBRARY_ROOT as a full path, since a relative one is taken from
# wherever the command was started.
# MEDIA_ROOT=
# PHOTO_LIBRARY_ROOT=
# Longest edge, in pixels, of the two sizes generated from each photograph.
# THUMBNAIL_MAX_PX=320
# WEB_MAX_PX=1600
# Uploads larger than these are refused before anything is decoded.
# MAX_UPLOAD_BYTES=26214400
# MAX_IMAGE_PIXELS=50000000

# --- development server --------------------------------------------------------

# Where the scripts start the API and the frontend. The frontend's own
# defaults are in frontend/dev-server.json, which the code reads too.
# CCWEB_API_HOST=127.0.0.1
# CCWEB_API_PORT=8000
# CCWEB_FRONTEND_HOST=127.0.0.1
# CCWEB_FRONTEND_PORT=5173
# pgAdmin and SonarQube, when used.
# CCWEB_PGADMIN_PORT=5050
# CCWEB_SONAR_PORT=9000

# The conda environment the scripts activate. Unset: ccwebdb, found from
# CONDA_EXE, then conda on PATH, then a miniforge3 folder in your home.
# CCWEB_CONDA_ENV=ccwebdb
# CCWEB_CONDA_ROOT=

# --- logs ----------------------------------------------------------------------

# The folder the scripts write logs to; how many files of each kind are
# kept; the size, in bytes, at which one rolls over (1 GiB).
# CCWEB_LOG_DIR=logs
# CCWEB_LOG_KEEP=3
# CCWEB_LOG_MAX_BYTES=1073741824

# --- backups -------------------------------------------------------------------

# Where the routine backup writes, and the time of day (HH:MM, local) the
# scheduled one runs. Unset, the folder is ccwebdb-backup in your home.
# Put it somewhere that leaves the machine -- a synced folder or a network
# share -- or copy it off yourself.
# CCWEB_BACKUP_DIR=
# CCWEB_BACKUP_TIME=20:00

# Where database dumps, workbook exports and media copies go when a command
# is given no folder. Unset: ccwebdb-backups beside the repository folder.
# CCWEB_ARCHIVE_DIR=

# --- public site ---------------------------------------------------------------

# Filled into deploy/Caddyfile when it is rendered for a public server: the
# domain, the certificate chain and key files, and the built frontend the
# web server serves (a copy it can read, where it cannot read the
# repository). Leave both certificate files empty and Caddy obtains and
# renews a free certificate itself; set one without the other and the
# rendering is refused.
# CCWEB_SITE_DOMAIN=
# CCWEB_TLS_CERT=
# CCWEB_TLS_KEY=
# CCWEB_SITE_ROOT=frontend/dist

# Caddyfiles of other sites the server runs beside the shop, kept outside
# the repository: a file, or a pattern such as
# C:/caddy/sites/*.caddy, imported at the end of the rendered Caddyfile.
# Unset: nothing is imported.
# CCWEB_CADDY_IMPORT=
